# Web 服务端口
PORT=8766

# Benchmark 数据集根目录
CAREHARNESS_DATA_ROOT=./data/benchmarks

# 本地 SQLite 数据库
CAREHARNESS_DB_PATH=./data/careharness.sqlite

# 可选：OpenAI-compatible 默认连接。请仅在本地 .env 中填写真实值。
OPENAI_API_KEY=

# 可选：CLI Benchmark 运行密钥。请仅在本地 .env 中填写真实值。
CAREHARNESS_MATCHED_API_KEY=

# 可选：CloseAI 官方 baseline 包装器密钥。请仅在本地 .env 中填写真实值。
CAREHARNESS_RUN_KEY=
